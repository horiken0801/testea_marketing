# ローカルで動作確認する際に使う環境変数のサンプルです。
# 実運用では GitHub Secrets に同じ名前で登録してください（.env は絶対にコミットしないこと）。

# X (Twitter) API - https://developer.x.com/en/portal/dashboard
# OAuth 1.0a のユーザーコンテキストで投稿するため、Consumer Key/Secret と
# Access Token/Secret（読み書き権限）の4つが必要です。
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Threads API - https://developers.facebook.com/docs/threads
# Threadsアカウントに紐づく長期アクセストークンと threads_user_id が必要です。
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# コンテンツ自動生成（任意）。未設定の場合は簡易テンプレートで代替します。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
